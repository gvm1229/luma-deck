{
  "name": "luma-deck",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "bin": {
    "lumadeck": "./dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "deck:build": "tsx src/deck/build.ts",
    "deck:diagnose:pptx-media": "tsx src/deck/pptx-spike.ts",
    "deck:export:pdf": "tsx src/deck/export-pdf.ts",
    "deck:package:mac": "tsx src/deck/package-mac.ts",
    "deck:package:win": "tsx src/deck/package-win.ts",
    "deck:pptx-spike": "tsx src/deck/pptx-spike.ts",
    "dev": "tsx src/cli/index.ts",
    "lumadeck": "tsx src/cli/index.ts",
    "studio:build": "tsc -p tsconfig.studio.json",
    "studio:dev": "pnpm studio:build && tsx studio/server.ts",
    "studio:import:final": "tsx studio/import-final.ts",
    "studio:e2e": "pnpm studio:build && vitest run test/studio/editor.e2e.test.ts",
    "studio:seed": "tsx studio/seed.ts",
    "studio:test": "pnpm studio:build && vitest run test/studio",
    "studio:typecheck": "tsc -p tsconfig.studio.json --noEmit",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=20.12.0"
  },
  "dependencies": {
    "@slidev/cli": "^52.0.0",
    "@slidev/theme-apple-basic": "^0.25.1",
    "@slidev/theme-default": "^0.25.0",
    "pretendard": "^1.3.9",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "electron": "^42.4.1",
    "electron-builder": "^26.15.3",
    "jszip": "^3.10.1",
    "playwright-chromium": "^1.61.0",
    "pptxgenjs": "^4.0.1",
    "prettier": "^3.8.4",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
